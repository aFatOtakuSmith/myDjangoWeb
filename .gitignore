# ==========================================
# 1. Python 字节码与缓存
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# 2. 虚拟环境
# ==========================================
venv/
.venv/
env/
ENV/
.venv*/
pip-selfcheck.json

# ==========================================
# 3. Django 运行时数据
# ==========================================
# SQLite 数据库（本地开发用；线上一般用 MySQL/Postgres，同样不提交）
db.sqlite3
db.sqlite3-journal

# 上传文件（头像、封面等用户数据，绝不能进仓库）
media/

# collectstatic 的产物（线上部署时生成，仓库里不留）
staticfiles/
/static_collected/

# 本地 settings / 密钥覆盖文件（如有）
local_settings.py
*.local.py

# ==========================================
# 4. 日志
# ==========================================
*.log
logs/
*.log.*

# ==========================================
# 5. 环境变量与密钥
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# 6. IDE / 编辑器
# ==========================================
.idea/
.vscode/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace
*.iml

# ==========================================
# 7. 操作系统
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==========================================
# 8. 测试与覆盖率
# ==========================================
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.mypy_cache/
.ruff_cache/

# ==========================================
# 9. 前端 / 构建产物（如果有）
# ==========================================
node_modules/
dist/
build/
*.egg-info/

# ==========================================
# 10. 杂项
# ==========================================
*.bak
*.tmp
*.orig
